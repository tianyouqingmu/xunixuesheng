# 应用启动参数
APP_HOST=127.0.0.1
APP_PORT=8000
APP_OPEN_BROWSER=true

# 知识库文件；留空时自动读取项目根目录下的 知识库*.docx
KNOWLEDGE_FILES=

# 腾讯云语音（一句话识别 ASR + 实时语音合成 TTS）
TENCENT_APP_ID=
TENCENT_SECRET_ID=
TENCENT_SECRET_KEY=
TENCENT_REGION=ap-shanghai
TENCENT_ASR_ENGINE_TYPE=16k_zh
TENCENT_ASR_HOTWORD_ID=
TENCENT_TTS_VOICE_TYPE=1001
TENCENT_TTS_SAMPLE_RATE=16000
TENCENT_TTS_CODEC=wav
TENCENT_TTS_SPEED=0
TENCENT_TTS_VOLUME=0
TENCENT_TTS_MODEL_TYPE=1

# 大模型配置：兼容 OpenAI Chat Completions 接口
LLM_API_KEY=
LLM_MODEL=
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_TEMPERATURE=0.45
LLM_MAX_TOKENS=1800
LLM_TIMEOUT_SECONDS=60
